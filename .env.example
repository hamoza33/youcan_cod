DATABASE_URL="postgresql://cod_user:cod_password@localhost:5432/cod_automation?schema=public"
REDIS_URL="redis://localhost:6379"

# COD Network
COD_NETWORK_BASE_URL="https://api.cod.network/v2"
COD_NETWORK_API_TOKEN=""
COD_NETWORK_CATALOG_ENDPOINT="/seller/marketplace/products"
COD_NETWORK_ACCOUNT_PRODUCTS_ENDPOINT="/seller/drop-products"
# Required before full marketplace import. If omitted, products already in COD account/drop list can still import using their existing SKU.
COD_NETWORK_ADD_PRODUCT_ENDPOINT=""
# Optional secret checked by /api/webhooks/cod-network via x-cod-webhook-secret.
COD_NETWORK_WEBHOOK_SECRET=""
IMPORT_DEFAULT_COUNTRY="SA"

# YouCan
YOUCAN_BASE_URL="https://api.youcan.shop"
# Store Admin API Bearer token. Client ID/secret alone are not enough; use OAuth to get this.
YOUCAN_API_TOKEN=""
YOUCAN_CLIENT_ID=""
YOUCAN_CLIENT_SECRET=""
YOUCAN_REDIRECT_URI="https://app.example.com/api/youcan/oauth/callback"
YOUCAN_REFRESH_TOKEN=""
YOUCAN_STORE_URL="https://your-youcan-store.example"
# YouCan variant option type used for text-button/tab display. Public docs do not document all numeric mappings.
YOUCAN_TEXT_BUTTON_VARIANT_TYPE="2"

# Google Merchant Center / Merchant API
GOOGLE_MERCHANT_ACCOUNT_ID=""
GOOGLE_MERCHANT_DATA_SOURCE_ID=""
GOOGLE_MERCHANT_ENABLED="false"
# Use either a mounted credentials file path or JSON in env. Never commit real values.
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
GMC_FEED_LABEL="SA"
GMC_CONTENT_LANGUAGE="ar"

# OpenAI-compatible AI provider. Development provider: DuckCoding.
AI_PROVIDER_NAME="DuckCoding"
AI_BASE_URL="https://www.duckcoding.ai/"
AI_API_KEY=""
AI_MODEL="claude-opus-4-8"

# Optional web search provider abstraction settings
WEB_SEARCH_PROVIDER="manual"
WEB_SEARCH_API_KEY=""

# Product image enrichment providers
# SerpApi Google Lens is used first for reverse-image visual matches.
SERPAPI_API_KEY=""
# Bright Data Google Images is used as a fallback when Lens cannot find 4-5 valid images.
BRIGHTDATA_API_KEY=""
BRIGHTDATA_SERP_ZONE="serp_api1"
IMAGE_ENRICHMENT_TARGET_COUNT="5"
IMAGE_ENRICHMENT_MAX_CANDIDATES="35"

# App
APP_BASE_URL="https://app.example.com"
ADMIN_PASSWORD="change-this"
WORKER_CONCURRENCY="4"
PRISMA_LOG_QUERIES="false"

# Optional one-off manual product import script/API inputs
# Run with: npm run import:single
PRODUCT_SKU=""
PRODUCT_NAME=""
PRODUCT_DESCRIPTION=""
PRODUCT_PRICE=""
PRODUCT_COST=""
PRODUCT_STOCK=""
PRODUCT_IMAGE_URLS=""
PRODUCT_CATEGORY_SLUG=""
PRODUCT_PUSH_GMC="false"
