{
  "name": "cod-youcan-gmc-automation",
  "version": "0.1.0",
  "private": true,
  "description": "COD Network to YouCan and Google Merchant Center automation for KSA products.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
