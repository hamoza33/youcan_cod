    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/lib/jobs/worker.ts",
    "sync:once": "tsx scripts/sync-once.ts",
    "sync:youcan-categories": "tsx scripts/sync-youcan-categories.ts",
    "import:single": "tsx scripts/import-single-product.ts",
    "recover:failed-products": "tsx scripts/recover-failed-products.ts",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@googleapis/content": "^12.0.0",
    "@prisma/client": "^6.10.1",
    "autoprefixer": "^10.4.21",
    "bullmq": "^5.56.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "google-auth-library": "^10.1.0",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.468.0",
    "next": "^15.3.4",
    "pino": "^9.7.0",
    "postcss": "^8.5.6",
    "prisma": "^6.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "slugify": "^1.6.6",
